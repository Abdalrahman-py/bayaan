.mcp.json

# Full QCF v4 mushaf (all 604 pages / 48 fonts) — kept locally, showcase bundles a subset
/qcf4-full/

# QCF4 font files (Uthman Taha / King Fahd Quran Complex) — redistribution not
# permitted without explicit rights-holder permission. Keep on disk locally for
# the app to build/run, never commit. See assets/ATTRIBUTION.md.
android/app/src/main/assets/qcf4/fonts/QCF4_*.ttf

# QCF4 mushaf page data + index — bundled into the showcase APK from disk, but
# not committed to keep the repo small (full 604-page set is large JSON).
android/app/src/main/assets/qcf4/pages/*.json
android/app/src/main/assets/qcf4/index.json

# Large local spike test audio (not for the repo)
spike/audio/

# Generated content pack — derived from content/ by scripts/build_content.py.
# Bundle it before an Android build: build_content.py --out android/app/src/main/assets/content
# (source of truth is content/; this is the packed copy, like the mushaf pages above).
android/app/src/main/assets/content/

# Local scratch / throwaway artifacts — never commit (kept only on this machine).
# (docs.zip and .scratch/ are local-only; the full-Quran text uthmani.json stays
# tracked — it's public-domain Quran text and is needed to build a fresh clone.)
.scratch/
docs.zip

# Supabase CLI local state — machine-specific (project ref/link info), never commit.
supabase/.temp/
